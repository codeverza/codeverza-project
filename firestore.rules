rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ TEMPORARY OPEN RULES FOR DEVELOPMENT
    // TODO: Secure these rules before production deployment

    // Contacts - Public can create, Authenticated can manage
    match /contacts/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Subscribers - Anyone can subscribe
    match /subscribers/{docId} {
      allow write: if true;
      allow read: if request.auth != null;
    }

    // Quotations (admin-created) - TEMPORARILY OPEN
    match /quotations/{docId} {
      allow read, write: if request.auth != null;
    }

    // Employee Quotations - TEMPORARILY OPEN
    match /employeeQuotations/{docId} {
      allow read, write: if request.auth != null;
    }

    // Joining Letters - TEMPORARILY OPEN
    match /joiningLetters/{docId} {
      allow read, write: if request.auth != null;
    }

    // ===== EMPLOYEE MANAGEMENT SYSTEM =====

    // Employees Collection - TEMPORARILY OPEN
    match /employees/{employeeId} {
      allow read, write: if request.auth != null;
    }

    // Employee Attendance - TEMPORARILY OPEN
    match /employeeAttendance/{attendanceId} {
      allow read, write: if request.auth != null;
    }

    // Leave Requests - TEMPORARILY OPEN
    match /employeeLeaves/{leaveId} {
      allow read, write: if request.auth != null;
    }

    // Salary Records - TEMPORARILY OPEN
    match /employeeSalary/{salaryId} {
      allow read, write: if request.auth != null;
    }

    // Projects - TEMPORARILY OPEN
    match /employeeProjects/{projectId} {
      allow read, write: if request.auth != null;
    }

    // Tasks - TEMPORARILY OPEN
    match /tasks/{taskId} {
      allow read, write: if request.auth != null;
    }

    // Employee Tasks (Legacy) - TEMPORARILY OPEN
    match /employeeTasks/{taskId} {
      allow read, write: if request.auth != null;
    }

    // Leads - TEMPORARILY OPEN
    match /leads/{leadId} {
      allow read, write: if request.auth != null;
    }

    // Sales Leads (Legacy) - TEMPORARILY OPEN
    match /salesLeads/{leadId} {
      allow read, write: if request.auth != null;
    }

    // Sales Follow-ups - TEMPORARILY OPEN
    match /salesFollowups/{followupId} {
      allow read, write: if request.auth != null;
    }

    // Sales Performance - TEMPORARILY OPEN
    match /salesPerformance/{performanceId} {
      allow read, write: if request.auth != null;
    }

    // Employee Documents - TEMPORARILY OPEN
    match /employeeDocuments/{documentId} {
      allow read, write: if request.auth != null;
    }

    // Employee Permissions - TEMPORARILY OPEN
    match /employeePermissions/{permissionId} {
      allow read, write: if request.auth != null;
    }

    // Login History - TEMPORARILY OPEN
    match /employeeLoginHistory/{loginId} {
      allow read, write: if request.auth != null;
    }

    // Employee Performance Reviews - TEMPORARILY OPEN
    match /employeePerformance/{performanceId} {
      allow read, write: if request.auth != null;
    }

    // Exit Management - TEMPORARILY OPEN
    match /employeeExits/{exitId} {
      allow read, write: if request.auth != null;
    }
  }
}
